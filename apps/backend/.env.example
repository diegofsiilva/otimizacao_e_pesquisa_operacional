# Configuracoes do servidor local
# Altere estes valores de acordo com a maquina/porta onde o backend vai rodar.
APP_HOST=127.0.0.1
APP_PORT=8000

# Origem(ns) do frontend que podem chamar a API.
# Separe multiplas origens por virgula.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,null

# Persistencia local do backend.
UPLOAD_DIR=./uploads


# Banco de dados PostgreSQL
DB_HOST=seu_host
DB_PORT=5432
DB_DATABASE=seu_banco
DB_USER=seu_usuario
DB_PASSWORD=sua_senha