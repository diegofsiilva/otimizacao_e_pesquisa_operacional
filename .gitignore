# =============================
# DADOS SIGILOSOS — NÃO REMOVER
# =============================
data/
*.csv
*.xlsx
*.xls
*.parquet
*.json
*.db
*.sqlite

# ==============================
# AMBIENTE PYTHON
# ==============================
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/

# ==============================
# JUPYTER NOTEBOOKS — OUTPUTS
# ==============================
.ipynb_checkpoints/

# ==============================
# VARIÁVEIS DE AMBIENTE
# ==============================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==============================
# RESULTADOS E OUTPUTS
# ==============================
output/
outputs/
results/
*.log

# ==============================
# FRONTEND — UNIVERSAL
# ==============================

# Dependências (qualquer stack JS/TS usa node_modules)
node_modules/

# Builds gerados — nomes variam por ferramenta, mas estes cobrem a maioria
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.output/
.vercel/
.netlify/

# Cache de ferramentas de build
.cache/
.parcel-cache/
.turbo/
.vite/

# Arquivos de lock — escolha apenas um para versionar (o do seu gerenciador)
# e ignore os demais para evitar conflitos entre npm, yarn e pnpm
# Descomente a linha do gerenciador que NÃO for usar:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Cobertura de testes
coverage/
.nyc_output/

# Storybook, se vier a ser usado
storybook-static/

# ==============================
# EDITORES
# ==============================
.vscode/
.idea/
*.swp
*.swo
*~

# ==============================
# SISTEMA OPERACIONAL
# ==============================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# ==============================
# ARQUIVOS TEMPORÁRIOS GERAIS
# ==============================
*.tmp
*.temp
*.bak
*.backup
*.orig
*.pid
*.seed
*.lock
tmp/
temp/

# ==============================
# DVC — CONTROLE DE VERSÃO DE DADOS
# ==============================
.dvc/cache
.dvc/tmp


# ==============================
# Rust
# ==============================
# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/