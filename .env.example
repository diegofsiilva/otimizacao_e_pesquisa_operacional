# Copie estes valores para as Environment Variables do projeto na Vercel.
# Nao comite .env real com senhas.

# URL publica do frontend na Vercel, sem barra final.
# Exemplo: https://g04-banco-pan.vercel.app
FRONTEND_ORIGINS=https://SEU-PROJETO.vercel.app

# Preferencial em producao: URL unica do PostgreSQL.
# Exemplos comuns de provedores gerenciados:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# Alternativa caso seu banco esteja separado em host/porta/usuario/senha.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# Pool menor para ambiente serverless.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=3

# Diretorios temporarios no Vercel.
LOCAL_DATA_DIR=/tmp/g04_data
UPLOAD_DIR=/tmp/g04_uploads
STATE_PATH=/tmp/g04_data/state.json
PARAMS_PATH=/tmp/g04_data/params.json

# Opcional em desenvolvimento local.
APP_HOST=http://127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5500
